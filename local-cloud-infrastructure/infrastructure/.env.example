# Docker Compose environment for Local Cloud Infrastructure
# Copy to .env in this directory when using GPU overlays.

# GPU profile overlay (optional):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.nvidia.yml
# COMPOSE_FILE=docker-compose.yml:docker/gpu.amd.yml

# AMD ROCm: numeric render group id from: getent group render | cut -d: -f3
RENDER_GID=render

# Ollama model to pull on first start (optional)
OLLAMA_MODEL=llama3.2
